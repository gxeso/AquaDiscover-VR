  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Habitat: Oceans worldwide, from coastal waters to the deep sea.


    Diet:
    Plankton, fish eggs, and small marine animals.


    Movement: Jellyfish pulse
    their bell to swim and drift with ocean currents.


    Unique Characteristics:
    Jellyfish have no brain, heart, or bones. Many species use stinging cells on
    their tentacles to capture prey.


    Fun Fact: Jellyfish have existed for hundreds
    of millions of years!'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
